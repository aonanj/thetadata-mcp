# Copy to .env for local Docker testing; never commit .env.
THETADATA_API_KEY=replace-with-your-thetadata-key
# Generate a separate token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_API_KEY=replace-with-a-separate-random-token-of-at-least-32-characters
THETADATA_MAX_CONCURRENT_REQUESTS=1
# On Render its onrender.com host is allowed automatically.
# Other hosts/custom domains: hostname only, not a URL.
MCP_ALLOWED_HOSTS=localhost
