# Copy to .env for local Docker testing; never commit .env.
THETADATA_API_KEY=replace-with-your-thetadata-key
MCP_AUTH_MODE=bearer
# Generate a separate token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_API_KEY=replace-with-a-separate-random-token-of-at-least-32-characters
THETADATA_MAX_CONCURRENT_REQUESTS=1
# On Render its onrender.com host is allowed automatically.
# Other hosts/custom domains: hostname only, not a URL.
MCP_ALLOWED_HOSTS=localhost

# ChatGPT web setup requires OAuth. See docs/auth0-setup.md before enabling it.
# MCP_AUTH_MODE=oauth
# MCP_OAUTH_ISSUER=https://thetadata-options.us.auth0.com/
# MCP_OAUTH_JWKS_URL=https://thetadata-options.us.auth0.com/.well-known/jwks.json
# MCP_RESOURCE_URL=https://YOUR-SERVICE.onrender.com/mcp
# MCP_OAUTH_ALGORITHM=RS256
# On Render, MCP_RESOURCE_URL defaults to https://<RENDER_EXTERNAL_HOSTNAME>/mcp.
# MCP_API_KEY is ignored in OAuth mode. CIMD/DCR use no pre-supplied client ID
# or secret. The Management API /api/v2/ audience and client_credentials grant
# are not the ChatGPT sign-in configuration.
